alias vi=nvim
alias cb="rm -rf build/ && cmake -B build -G Ninja"

# Replace ls with eza
# alias ls='eza'
# Long format with headers and icons
alias ll='eza -l --header --icons'  # ll -B for raw byte sizes
# Long format including hidden files
alias la='eza -la --header --icons'
# Tree view shortcut
alias tree='eza --tree'

# batcat
alias bat=batcat
