[core]
  editor = nvim
  pager = delta
[user]
	email = lmquan.1860@gmail.com
	name = minhquan186
[alias]
  st = status
  cm = commit
  co = checkout
  br = branch
  hist = "log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --"
[include]
  # Catppuccin delta themes (stowed from git/.config/delta)
  path = ~/.config/delta/catppuccin.gitconfig
[delta]
    features = catppuccin-mocha
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection
    side-by-side = true
  line-numbers = true
[interactive]
  diffFilter = delta --color-only   # delta colors in git add -p
[merge]
    conflictStyle = zdiff3
	tool = nvimdiff
[fetch]
	prune = true
[diff]
	tool = nvimdiff
[include]
  # Machine-local, untracked overrides (e.g. a work identity via
  # [includeIf "gitdir:~/work/"]). Ignored if the file does not exist.
  path = ~/.gitconfig.local
